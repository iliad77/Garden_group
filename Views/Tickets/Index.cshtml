@* Author: Luca Mulders & Chris *@
@model List<Garden_group.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
    var counts = ViewBag.StatusCounts as Dictionary<Garden_group.Models.TicketStatus, int>;

    // CHRIS: State management for Search inputs
    string currentQuery = ViewBag.SearchQuery as string ?? "";
    string currentMode = ViewBag.SearchMode as string ?? "AND";
    string? errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Tickets (@(Model?.Count ?? 0))</h1>
    </div>

    <!-- Status summary badges -->
    @if (counts != null && counts.Any())
    {
        <div class="mb-3">
            @foreach (var status in counts)
            {
                <span class="badge bg-secondary me-2 p-2">
                    <strong>@status.Key:</strong> @status.Value
                </span>
            }
        </div>
    }

    <!-- CHRIS: Server-side Search Error Alert -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show my-3" role="alert">
            <strong>Notice:</strong> @errorMessage
            <a asp-action="Index" class="alert-link ms-2">View all tickets</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- CHRIS: Functionality 1 - Search Form (AND/OR) -->
    <div class="card mb-3 p-3 bg-light shadow-sm">
        <form asp-controller="Tickets" asp-action="Search" method="get" class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" name="query" value="@currentQuery" class="form-control" placeholder="Search ticket subject or content..." />
            </div>
            <div class="col-md-4 d-flex align-items-center gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="searchMode" id="modeAnd" value="AND" @(currentMode == "AND" ? "checked" : "")>
                    <label class="form-check-label" for="modeAnd">AND</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="searchMode" id="modeOr" value="OR" @(currentMode == "OR" ? "checked" : "")>
                    <label class="form-check-label" for="modeOr">OR</label>
                </div>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-primary w-100">Search DB</button>
            </div>
        </form>
    </div>

    <!-- CHRIS: Functionality 2 - Filter On Preloaded Table -->
    <div class="row mb-3">
        <div class="col-md-5 ms-auto">
            <input type="text" id="liveFilterInput" class="form-control" placeholder="Filter loaded tickets by keyword..." onkeyup="filterPreloadedTickets()" />
        </div>
    </div>

    <!-- Tickets Table -->
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Subject</th>
                <th>Type</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Reported</th>
                <th>Handled</th>
            </tr>
        </thead>
        <tbody id="ticketTableBody">
            @if (Model != null && Model.Any())
            {
                @foreach (var ticket in Model)
                {
                    <tr class="ticket-row">
                        <td><strong>@ticket.Subject</strong></td>
                        <td>@(ticket.IncidentType.ToString())</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @ticket.Priority
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                @ticket.Status
                            </span>
                        </td>
                        <td>@ticket.TimeReported.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@(ticket.HandledBy != null ? ticket.HandledBy.Count : 0)</td>
                    </tr>
                }

                <!-- CHRIS: Dynamic row shown when live client-side filter yields 0 matches -->
                <tr id="noFilterMatchRow" style="display: none;">
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-search me-1"></i> No tickets found matching your filter keyword.
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No tickets found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- CHRIS: Functionality 2 - Instant Client-Side Filter Script -->
@section Scripts {
    <script>
        function filterPreloadedTickets() {
            const query = document.getElementById("liveFilterInput").value.trim().toLowerCase();
            const rows = document.querySelectorAll("#ticketTableBody tr.ticket-row");
            const noMatchRow = document.getElementById("noFilterMatchRow");
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const matches = text.includes(query);
                row.style.display = matches ? "" : "none";
                if (matches) {
                    visibleCount++;
                }
            });

            // Toggle the empty state row dynamically
            if (noMatchRow) {
                noMatchRow.style.display = (visibleCount === 0 && query !== "") ? "" : "none";
            }
        }
    </script>
}