@model Garden_group.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Add user – NoDesk";
    ViewData["IsCreate"] = true;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
        a.nav-item, a.btn { display: inline-block; text-decoration: none; }
        a.nav-item { display: block; }
    </style>
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <div class="brand">NoDesk</div>
        <nav>
            <a asp-controller="Home" asp-action="Index" class="nav-item">Dashboard</a>
            <a asp-controller="Tickets" asp-action="Index" class="nav-item">Tickets</a>
            <a asp-controller="User" asp-action="Index" class="nav-item active">Manage users</a>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <div class="eyebrow">SERVICE DESK</div>
                <h2>Add user</h2>
            </div>
        </header>

        <section class="page">
            <div class="panel form-panel">
                <h3>Create new user</h3>
                <form asp-action="Create" method="post">
                    <partial name="_UserForm" model="Model" view-data="ViewData" />
                </form>
            </div>
        </section>
    </main>
</div>
</body>
</html>
