@model List<Garden_group.Models.User>
@inject Garden_group.Repositories.ITicketRepository TicketRepository
@{
    Layout = null;
    ViewData["Title"] = "Manage users – NoDesk";

    // Open tickets per user (last handler of each unresolved ticket)
    var openPerUser = await TicketRepository.GetOpenTicketCountPerAssigneeAsync();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
        a.nav-item, a.btn { display: inline-block; text-decoration: none; }
        a.nav-item { display: block; }

        /* Small icon buttons for add / edit / delete */
        .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px;
                    border: 1px solid var(--border); border-radius: 7px; background: #fff; color: var(--text); padding: 0; }
        .icon-btn:hover { background: #f1f5f9; }
        .icon-btn.danger:hover { color: #dc2626; border-color: #dc2626; }
        .icon-btn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
        .icon-btn.primary:hover { background: var(--primary-dark); }
        .row-actions { display: flex; gap: 6px; justify-content: flex-end; }
        .row-actions form { margin: 0; }
    </style>
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <div class="brand">NoDesk</div>
        <nav>
            <a asp-controller="Home" asp-action="Index" class="nav-item">Dashboard</a>
            <a asp-controller="Tickets" asp-action="Index" class="nav-item">Tickets</a>
            <a asp-controller="User" asp-action="Index" class="nav-item active">Manage users</a>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <div class="eyebrow">SERVICE DESK</div>
                <h2>Manage users</h2>
            </div>
            <a asp-action="Create" class="icon-btn primary" title="Add new user" aria-label="Add new user">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            </a>
        </header>

        <section class="page">
            <div class="panel">
                <div class="panel-head">
                    <h3>User management</h3>
                    <span class="muted">@Model.Count users</span>
                </div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>First name</th>
                                <th>Last name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Open tickets</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Name.First</td>
                                    <td>@user.Name.Last</td>
                                    <td>@user.Email</td>
                                    <td>@user.Phone</td>
                                    <td>@user.UserType</td>
                                    <td>@user.Address</td>
                                        <td>@(openPerUser.TryGetValue(user.Id, out var openCount) ? openCount : 0)</td>
                                    <td>
                                        <div class="row-actions">
                                            <a asp-action="Edit" asp-route-id="@user.Id.ToString()" class="icon-btn" title="Edit user" aria-label="Edit user">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@user.Id.ToString()" method="post"
                                                  onsubmit="return confirm('Delete @user.Name.First @user.Name.Last?');">
                                                <button type="submit" class="icon-btn danger" title="Delete user" aria-label="Delete user">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="8" class="muted">No users found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</div>
</body>
</html>
