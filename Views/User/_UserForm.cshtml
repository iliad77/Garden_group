@model Garden_group.Models.User
@using Garden_group.Models
@{
    bool isCreate = (bool)(ViewData["IsCreate"] ?? false);
}

<div asp-validation-summary="ModelOnly" class="muted"></div>

<div class="form-grid">
    <label>First name
        <input asp-for="Name.First" required>
    </label>
    <label>Last name
        <input asp-for="Name.Last" required>
    </label>
    <label>E-mail address
        <input asp-for="Email" type="email" required>
    </label>
    <label>Phone number
        <input asp-for="Phone">
    </label>
    <label>Type of user
        <select asp-for="UserType" asp-items="Html.GetEnumSelectList<UserType>()"></select>
    </label>
    <label>Location / branch
        <input asp-for="Address">
    </label>
    <label class="full-row">
        @(isCreate ? "Password" : "New password (leave empty to keep the current one)")
        <input asp-for="Password" type="password" required="@isCreate" autocomplete="new-password">
        <span asp-validation-for="Password" class="muted"></span>
    </label>
    <div class="form-actions full-row">
        <a asp-action="Index" class="btn">CANCEL</a>
        <button type="submit" class="btn primary">@(isCreate ? "ADD USER" : "SAVE CHANGES")</button>
    </div>
</div>
